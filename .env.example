# Copy this file to .env and replace every local credential before starting the project.
# .env is ignored by Git; this template must never contain a real API key or production secret.

APP_ENV=local
SERVICE_VERSION=0.1.0

# BFF identity.
BFF_JWT_SECRET=replace-with-at-least-32-random-characters
BFF_JWT_ISSUER=cs-agent-bff
BFF_JWT_AUDIENCE=cs-agent-ui
BFF_JWT_TTL_SECONDS=3600

# Application service connections used when Python services run on macOS.
DATABASE_URL=postgresql+psycopg://cs_agent:change-this-local-password@127.0.0.1:5432/cs_agent
CUSTOMER_DATA_URL=http://127.0.0.1:8002
AI_RUNTIME_URL=http://127.0.0.1:8001
AI_RUNTIME_INTERNAL_TOKEN=replace-with-a-random-internal-token
# 完整图执行可能依次包含路由、检索、精排和生成，不能沿用只读检查的短超时。
AI_RUNTIME_EXECUTE_TIMEOUT_SECONDS=60
AI_RUNTIME_INSPECT_TIMEOUT_SECONDS=10
ACTIVE_DECISION_PROFILE=BASELINE
DECISION_TIMEOUT_MS=800
# Jev 首版只用于离线和 Shadow；空密钥时 baseline 独立运行。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_TIMEOUT_SECONDS=0.8
SOP_LLM_ENABLED=true
BUSINESS_TOOL_TIMEOUT_SECONDS=5
BUSINESS_TIMEZONE=Asia/Shanghai

REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
SEMANTIC_ENABLED=true
SEMANTIC_INDEX_VERSION=semantic-v3
SEMANTIC_INTENT_MIN_SCORE=0.60
SEMANTIC_INTENT_MARGIN=0.04
SEMANTIC_FAQ_MIN_SCORE=0.75
SEMANTIC_FAQ_MARGIN=0.03
FAQ_RERANK_MIN_SCORE=0.50
FAQ_RERANK_MIN_MARGIN=0.10

# 分类、Query 改写、SOP 理解和 RAG 草稿生成共用的主语言模型。
# 当前示例使用 DeepSeek 的 OpenAI 兼容接口；切换供应商时不需要修改调用方字段名。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=15
LLM_ROUTING_TIMEOUT_SECONDS=8
LLM_ROUTING_FAST_RETRY_TIMEOUT_SECONDS=3
LLM_CONTEXT_WINDOW_TOKENS=1048576
CONTEXT_EFFECTIVE_WINDOW_TOKENS=32768
CONTEXT_COMPRESSION_TRIGGER_RATIO=0.8
CONTEXT_DYNAMIC_INPUT_RESERVE_TOKENS=8192
CONTEXT_OUTPUT_RESERVE_TOKENS=4096
CONTEXT_RECENT_TURN_BUDGET_TOKENS=11264
CONTEXT_SUMMARY_BUDGET_TOKENS=2048
CONTEXT_REBASELINE_AFTER_COMPRESSIONS=4
CONTEXT_SUMMARY_SOURCE_REF_LIMIT=32
QUALITY_ASYNC_ENABLED=true
QUALITY_SHADOW_ENABLED=true
QUALITY_POLL_INTERVAL_SECONDS=1
QUALITY_MAX_ATTEMPTS=3
RUNTIME_ARTIFACT_RETENTION_DAYS=30
RAG_REVIEW_TTL_MINUTES=30
RUNTIME_ARTIFACT_CACHE_SIZE=128
TOOL_ARTIFACT_EXTERNALIZE_BYTES=4096
RAG_ENABLED=false
RAG_GENERATION_ENABLED=false
RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RERANK_TOP_N=5
RAG_MIN_RERANK_SCORE=0.35
RAG_MIN_RERANK_MARGIN=0.05
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_TIMEOUT_SECONDS=8

# Docker Compose infrastructure settings.
POSTGRES_IMAGE=postgres:16.14-alpine3.24
POSTGRES_DB=cs_agent
POSTGRES_USER=cs_agent
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7.2.14-bookworm
REDIS_PORT=6379

ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MILVUS_IMAGE=milvusdb/milvus:v2.6.7
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091

NGINX_IMAGE=nginx:1.27.5-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
